 	log(" [Linked choke points wiht regions in " << seconds << " seconds]");
 	start = end;
 
+	// NNB: a CHK start is an exact depot anchor, not a mineral-cluster estimate.
+	// Correct before nearest-object maps and all base distances are computed.
+	std::set<BWTA::BaseLocation*> anchored;
+	for (auto start : MapData::startLocations) {
+		BWTA::BaseLocationImpl* best = nullptr;
+		double distance = 10.0;
+		for (auto candidate : BWTA_Result::baselocations) {
+			if (anchored.count(candidate)) continue;
+			double d = candidate->getTilePosition().getDistance(start);
+			if (d < distance) { distance = d; best = static_cast<BWTA::BaseLocationImpl*>(candidate); }
+		}
+		if (!best) throw std::runtime_error("No resource base near CHK start");
+		if (best->tilePosition != start) {
+			std::cout << "CHK start anchor " << best->tilePosition << " -> " << start << std::endl;
+			best->tilePosition = start;
+			best->position = BWAPI::Position(start.x * 32 + 64, start.y * 32 + 48);
+		}
+		anchored.insert(best);
+	}
 	calculate_connectivity();
 	calculate_base_location_properties(get_component,components,BWTA_Result::baselocations);
 
